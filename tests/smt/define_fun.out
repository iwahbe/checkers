-- stdout
(set-logic ALL)
(define-fun |pos#cond| ((n Int)) Bool (> n 0))
(define-fun |both#cond| ((a Int) (b Int)) Bool (and (|pos#cond| a) (|pos#cond| b)))
(define-fun-rec sum ((n Int)) Int (ite (|both#cond| n 1) (+ n (sum (- n 1))) 0))
(declare-const x Int)
(assert (not (>= (sum x) 0)))
(check-sat)
-- stderr
-- exit 0
