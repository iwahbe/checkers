-- stdout
(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :reproducible-resource-limit 1000)
(set-option :timeout 2000)
(set-logic ALL)
(declare-sort S 0)
(declare-const x Int)
(assert (! (> x 0) :named S))
(assert (! (> x 1) :named T))
(declare-sort T 0)
(assert (not (= x 1)))
(check-sat)
-- stderr
-- exit 0
