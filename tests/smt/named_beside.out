-- stdout
(set-option :produce-unsat-cores true)
(set-logic ALL)
(declare-const a Int)
(define-fun-rec b () Int 3)
(define-fun c ((y Int)) Bool true)
(declare-fun d (Int) Bool)
(declare-datatypes ((T 0)) (((K) (L (f Int)))))
(declare-const x Int)
(assert (! (> x 0) :named a))
(assert (! (> x 1) :named b))
(assert (! (> x 2) :named c))
(assert (! (> x 3) :named d))
(assert (! (> x 4) :named K))
(assert (! (> x 5) :named L))
(assert (! (> x 6) :named f))
(assert (! (> x 7) :named is-K))
(assert (! (> x 8) :named n))
(assert (! (> x 9) :named N))
(assert (! (> x 10) :named S))
(declare-fun n (Int) Int)
(define-fun-rec m ((y Int)) Int 3)
(declare-datatypes ((P 1)) ((par (X) ((N) (C (h X))))))
(declare-sort S 0)
(assert (not (= x 1)))
(check-sat)
-- stderr
-- exit 0
