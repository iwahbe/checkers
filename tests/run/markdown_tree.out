-- stdout
h1 "# Title *x*"
  text "Title " "Title "
  emph "*x*"
    text "x" "x"
quote "> quote\n> - a [b] `c` [nope]\n>   more"
  para "quote"
    text "quote" "quote"
  bullets True "- a [b] `c` [nope]\n>   more"
    item "- a [b] `c` [nope]\n>   more"
      para "a [b] `c` [nope]\n>   more"
        text "a " "a "
        link /url Some "b" "[b]"
          text "b" "b"
        text " " " "
        code "`c`"
        text " [nope]" " [nope]"
        soft "\n>   "
        text "more" "more"
code "checkers" "```checkers\nfn f\n  x\n```" lines "fn f""  x"
code "" "indented" lines "indented"
para "- tab item  \n  next"
  text "- tab item" "- tab item"
  hard "  \n  "
  text "next" "next"
[("b", "\"[b]: /url\"")]
[("nope", "\"[nope]\"")]
-- stderr
-- exit 0
