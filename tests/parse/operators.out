(module operators)
(check (== ((+) 1 2) (+ 1 2)))
(check (== (map (section + _ 1) xs) (map (section + 1 _) xs)))
(check ($ f ($ g (h x))))
(check (== ((. f g) x) (f (g x))))
(check (== (+ (* a b) (* c d)) (+ (* a b) (* c d))))
(check (== (:: x (:: y zs)) (:: x (:: y zs))))
(check (implies (or (and a b) c) d))
(check (* (neg x) y))
(check (- f 1))
(check (not (< a b)))
(check (== v.stop (len src)))
(check (decimal.scan_json src i))
(check (Some (index src i)))
(check (f [i]))
(check (f x).value)
(check (== (index b"abc" 0) 'a'))
(check (++ (++ xs [1 2]) []))
(check (tuple 1 "two" c'3'))
(check ())
