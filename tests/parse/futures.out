(module futures)
(fn f (sched xs)
  (do
    (let (tuple a b c) (par (g xs) (h xs) (k xs)))
    (let pair (map2 combine (par one two)))
    (let p ($ (future.fork sched) (\ (_) 1)))
    (let q (+ (future.join p) 1))
    (let (tuple x y) (future.join (tuple p q)))
    (let r ($ (future.fork sched) (\ (_) (do
      (let z (+ x y))
      z))))
    (let s (join "," (fork_names xs)))
    r))
