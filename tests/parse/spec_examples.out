(module spec_examples)
(fn foo (x y) -> z
  (: (x~Int) (y~String))
  (+ (format x) y))
(fn sort (xs) -> ys
  (: (xs~(List Int)) (sorted ys) (perm xs ys))
  (insertion_sort xs))
(fn map (f xs) -> ys
  (: (f~(-> a b)) (xs~(List a)))
  (match xs
      ([] -> [])
      ((:: x rs) -> (:: (f x) (map f rs)))))
(check (== '\"' 34))
(check (== (++ "'" "s") "'s"))
