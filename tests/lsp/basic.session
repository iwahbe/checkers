# The server in an editor that takes UTF-8 positions (Eglot): diagnostics in
# phases, a fix that reveals a proof failure, then the requests (§15.5).
> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"capabilities":{"general":{"positionEncodings":["utf-32","utf-8","utf-16"]}}}}
< 1
> {"jsonrpc":"2.0","method":"initialized","params":{}}
# A type error: published after the types phase, and again after each of
# the other two (which have nothing to add, since types failed).
> {"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck","languageId":"checkers","version":1,"text":$TEXT(demo.ck)}}}
< 3
# Fixed: no diagnostics after the types phase; then the proof failure.
> {"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck","version":2},"contentChanges":[{"text":"module demo\n\nrecord Point\n    x~Nat\n    y~Nat\n\nlet ORIGIN = Point 0 0\n\nfn sum p -> r : p~Point, r~Nat, r > 100\n    p.x + p.y\n"}]}}
< 2
# Hover over the parameter `p` in the body, and the field `x`.
> {"jsonrpc":"2.0","id":2,"method":"textDocument/hover","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"},"position":{"line":9,"character":4}}}
< 1
> {"jsonrpc":"2.0","id":3,"method":"textDocument/hover","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"},"position":{"line":9,"character":6}}}
< 1
# Go to the definition of `x`, and of `Point` in the constraint.
> {"jsonrpc":"2.0","id":4,"method":"textDocument/definition","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"},"position":{"line":9,"character":6}}}
< 1
> {"jsonrpc":"2.0","id":5,"method":"textDocument/definition","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"},"position":{"line":8,"character":20}}}
< 1
# Nothing at a blank position.
> {"jsonrpc":"2.0","id":6,"method":"textDocument/hover","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"},"position":{"line":1,"character":0}}}
< 1
> {"jsonrpc":"2.0","id":7,"method":"textDocument/documentSymbol","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"}}}
< 1
> {"jsonrpc":"2.0","id":8,"method":"textDocument/semanticTokens/full","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"}}}
< 1
# Opening a second file checks it; `demo.ck`'s diagnostics stay as they
# are (nothing is published for it). Formatting: an edit for a messy file,
# none for a formatted one.
> {"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/messy.ck","languageId":"checkers","version":1,"text":$TEXT(messy.ck)}}}
> {"jsonrpc":"2.0","id":9,"method":"textDocument/formatting","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/messy.ck"},"options":{"tabSize":4,"insertSpaces":true}}}
< 1
> {"jsonrpc":"2.0","id":10,"method":"textDocument/formatting","params":{"textDocument":{"uri":"file://$ROOT/tests/lsp/demo.ck"},"options":{"tabSize":4,"insertSpaces":true}}}
< 1
# An unknown request is an error; an unknown notification is ignored.
> {"jsonrpc":"2.0","method":"$/unknownNotification","params":{}}
> {"jsonrpc":"2.0","id":11,"method":"workspace/unknown","params":{}}
< 1
> {"jsonrpc":"2.0","id":12,"method":"shutdown"}
< 1
> {"jsonrpc":"2.0","method":"exit"}
