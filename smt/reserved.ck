# reserved.ck — the spellings Z3 gives a meaning of its own.
#
# `RESERVED` is measured, not remembered: scripts/reserved.py asks Z3 5.3.3
# about every simple symbol in the words of its executable and library, and
# lists each it doesn't call unknown (smt/reserved.txt is the same list). It
# is as complete as that measurement, and no more.

module reserved

import std.array
import std.bytes

# Whether Z3 gives `name` a meaning of its own: a function, a sort, an
# indexed name, or a word of its syntax.
#
# Z3 reads `bv` and digits as a bit-vector literal (`(_ bv5 8)`) whatever
# the digits: measured at `bv0` to `bv9` and `bv1234567890`, so every such
# spelling counts. Likewise `#f`, digits, `m` and digits is a finite-field
# literal to Z3, also written between bars.
export fn is_reserved name -> r : name~Bytes, r~Bool
    bv_literal name or ff_literal name or find name 0 (len RESERVED)

fn bv_literal name -> r : name~Bytes, r~Bool
    len name > 2 and name[0] == 'b' and name[1] == 'v' and digits name 2

fn ff_literal name -> r : name~Bytes, r~Bool
    len name > 2 and name[0] == '#' and name[1] == 'f' and ff_value name 2

# Digits from `i`, then `m` and digits to the end.
fn ff_value name i -> r : name~Bytes, i~Nat, i <= len name, r~Bool
    let j = digits_end name i
    j > i and j < len name and name[j] == 'm' and j + 1 < len name and digits name (j + 1)

fn digits_end name i -> j : name~Bytes, i~Nat, i <= len name, j~Nat, i <= j, j <= len name
    decreasing len name - i
    if i < len name and '0' <= name[i] and name[i] <= '9' then digits_end name (i + 1) else i

fn digits name i -> r : name~Bytes, i~Nat, i <= len name, r~Bool
    decreasing len name - i
    if i >= len name then True else '0' <= name[i] and name[i] <= '9' and digits name (i + 1)

# `RESERVED`, one spelling per line, in order: smt/reserved.txt's text.
export fn listing -> r : r~Bytes
    bytes.concat (lines (array.to_list RESERVED))

fn lines ss -> r : ss~List Bytes, r~List Bytes
    match ss
        []        -> []
        s :: rest -> s :: b"\n" :: lines rest

# Whether `s` is in `RESERVED` between `lo` and `hi`, which is sorted by
# `before`. (`Bytes` has no `Ord` in `std`, #459.)
fn find s lo hi -> r : s~Bytes, lo~Nat, hi~Nat, lo <= hi, hi <= len RESERVED, r~Bool
    decreasing hi - lo
    if lo < hi
        let mid = lo + (hi - lo) / 2
        let k = RESERVED[mid]
        if s == k then True else if before s k 0 then find s lo mid else find s (mid + 1) hi
    else
        False

# Whether `a` comes before `b` byte by byte from `i`, a prefix first: the
# order of scripts/reserved.py's `sorted` on ASCII.
fn before a b i -> r : a~Bytes, b~Bytes, i~Nat, i <= len b, r~Bool
    decreasing len b - i
    if i >= len b
        False
    else if i >= len a
        True
    else if a[i] != b[i]
        a[i] < b[i]
    else
        before a b (i + 1)

