(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |first#1| Int)
(declare-const |start#2| Int)
(assert (! (>= |first#1| 0) :named |given.0|))
(assert (! (>= |start#2| 0) :named |given.1|))
(assert (! (>= |first#1| 0) :named |fact.0|))
(assert (! (>= |start#2| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|first#1| |start#2|))
