(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |b#1| (Seq Int))
(declare-const |i#2| Int)
(declare-const |c#0| Int)
(assert (>= |i#2| 0))
(assert (>= |c#0| 0))
(assert (>= (seq.nth |b#1| |i#2|) 0))
(assert (< (seq.nth |b#1| |i#2|) 256))
(assert (>= |c#0| 0))
(assert (>= |i#2| 0))
(assert (= (ite (not (< |i#2| (seq.len |b#1|))) false (= (seq.nth |b#1| |i#2|) |c#0|)) true))
(assert (not (ite (not (<= 0 (- (seq.len |b#1|) |i#2|))) false (< (- (seq.len |b#1|) (+ |i#2| 1)) (- (seq.len |b#1|) |i#2|)))))
(check-sat)
(get-value (|b#1| |i#2| |c#0|))
