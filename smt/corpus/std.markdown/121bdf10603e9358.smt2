(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |stop#1| Int)
(declare-const |i#2| Int)
(declare-const |col#3| Int)
(assert (! (>= |stop#1| 0) :named |given.0|))
(assert (! (>= |i#2| 0) :named |given.1|))
(assert (! (>= |col#3| 0) :named |given.2|))
(assert (! (>= |stop#1| 0) :named |fact.0|))
(assert (! (>= |i#2| 0) :named |fact.1|))
(assert (! (>= |col#3| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|stop#1| |i#2| |col#3|))
