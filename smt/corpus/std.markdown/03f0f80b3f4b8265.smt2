(assert (= (= (|#std.markdown.lower| (|#std.markdown.at| |#b#0| (+ |#i#1| |#k#3|))) (seq.nth |#word#2| |#k#3|)) true))
(assert (not (ite (not (<= 0 (- (seq.len |#word#2|) |#k#3|))) false (< (- (seq.len |#word#2|) (+ |#k#3| 1)) (- (seq.len |#word#2|) |#k#3|)))))
(check-sat)
(get-value (|#word#2| |#k#3| |#i#1| |#b#0|))
