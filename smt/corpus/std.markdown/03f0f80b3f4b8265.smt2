(assert (=> (>= (|#std.markdown.at| |#b#0| (+ |#i#1| |#k#3|)) 0) (>= (|#std.markdown.lower| (|#std.markdown.at| |#b#0| (+ |#i#1| |#k#3|))) 0)))
