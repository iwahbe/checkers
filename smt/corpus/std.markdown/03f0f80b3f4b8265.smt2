(set-logic ALL)
(define-funs-rec ((|#std.markdown.at| ((p0 (Seq Int)) (p1 Int)) Int) (|#std.markdown.lower| ((p0 Int)) Int)) ((ite (not (< p1 (seq.len p0))) 256 (seq.nth p0 p1)) (ite (not (ite (not (>= p0 65)) false (<= p0 90))) p0 (+ p0 32))))
