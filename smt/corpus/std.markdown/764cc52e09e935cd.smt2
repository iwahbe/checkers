(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|std.char.is_digit| ((p0 Int)) Bool) (|std.markdown.lower| ((p0 Int)) Int)) ((ite (not (<= 48 p0)) false (<= p0 57)) (ite (not (ite (not (>= p0 65)) false (<= p0 90))) p0 (+ p0 32))))
(declare-const |b#0| (Seq Int))
(declare-const |i#1| Int)
(declare-const |j#2| Int)
(declare-const |base#3| Int)
(declare-const |acc#4| Int)
(assert (>= |i#1| 0))
(assert (>= (seq.nth |b#0| |i#1|) 0))
(assert (< (seq.nth |b#0| |i#1|) 256))
(assert (>= |j#2| 0))
(assert (>= |base#3| 0))
(assert (>= |acc#4| 0))
(assert (=> (>= (seq.nth |b#0| |i#1|) 0) (>= (|std.markdown.lower| (seq.nth |b#0| |i#1|)) 0)))
(assert (=> (>= (seq.nth |b#0| |i#1|) 0) (>= (|std.markdown.lower| (seq.nth |b#0| |i#1|)) 0)))
(assert (>= |i#1| 0))
(assert (>= |j#2| 0))
(assert (>= |base#3| 0))
(assert (>= |acc#4| 0))
(assert (= (ite (not (< |i#1| |j#2|)) false (< |i#1| (seq.len |b#0|))) true))
(assert (= (|std.char.is_digit| (|std.markdown.lower| (seq.nth |b#0| |i#1|))) true))
(assert (not (>= (|std.markdown.lower| (seq.nth |b#0| |i#1|)) 48)))
(check-sat)
(get-value (|b#0| |i#1| |j#2| |base#3| |acc#4|))
