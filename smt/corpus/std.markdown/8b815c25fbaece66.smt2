(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#level#2| Int)
(assert (! (>= |#level#2| 0) :named |given.0|))
(assert (! (<= 1 |#level#2|) :named |given.1|))
(assert (! (<= |#level#2| 6) :named |given.2|))
(assert (! (<= 1 |#level#2|) :named |fact.0|))
(assert (! (<= |#level#2| 6) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#level#2|))
