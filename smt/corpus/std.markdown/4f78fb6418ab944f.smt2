(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#start#3| Int)
(declare-const |#stop#4| Int)
(assert (! (>= |#start#3| 0) :named |given.0|))
(assert (! (>= |#stop#4| 0) :named |given.1|))
(assert (! (>= |#start#3| 0) :named |fact.0|))
(assert (! (>= |#stop#4| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#start#3| |#stop#4|))
