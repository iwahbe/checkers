(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |index#3| Int)
(declare-const |start#4| Int)
(assert (! (>= |index#3| 0) :named |given.0|))
(assert (! (>= |start#4| 0) :named |given.1|))
(assert (! (>= |index#3| 0) :named |fact.0|))
(assert (! (>= |start#4| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|index#3| |start#4|))
