(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |i#3| Int)
(declare-const |j#4| Int)
(assert (! (>= |i#3| 0) :named |given.0|))
(assert (! (>= |j#4| 0) :named |given.1|))
(assert (! (>= |i#3| 0) :named |fact.0|))
(assert (! (>= |j#4| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|i#3| |j#4|))
