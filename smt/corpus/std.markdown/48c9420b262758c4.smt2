(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |tok#0| Int)
(declare-const |index#4| Int)
(declare-const |start#5| Int)
(assert (! (>= |tok#0| 0) :named |given.0|))
(assert (! (>= |index#4| 0) :named |given.1|))
(assert (! (>= |start#5| 0) :named |given.2|))
(assert (! (>= |tok#0| 0) :named |fact.0|))
(assert (! (>= |index#4| 0) :named |fact.1|))
(assert (! (>= |start#5| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|tok#0| |index#4| |start#5|))
