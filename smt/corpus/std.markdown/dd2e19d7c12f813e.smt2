(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#d#1| Int)
(declare-const |#last#2| Int)
(declare-const |#stop#3| Int)
(assert (! (>= |#d#1| 0) :named |given.0|))
(assert (! (>= |#last#2| 0) :named |given.1|))
(assert (! (>= |#stop#3| 0) :named |given.2|))
(assert (! (>= |#d#1| 0) :named |fact.0|))
(assert (! (>= |#last#2| 0) :named |fact.1|))
(assert (! (>= |#stop#3| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#d#1| |#last#2| |#stop#3|))
