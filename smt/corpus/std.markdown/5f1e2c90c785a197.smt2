(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |last#1| Int)
(declare-const |stop#2| Int)
(assert (! (>= |last#1| 0) :named |given.0|))
(assert (! (>= |stop#2| 0) :named |given.1|))
(assert (! (>= |last#1| 0) :named |fact.0|))
(assert (! (>= |stop#2| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|last#1| |stop#2|))
