(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |start#2| Int)
(declare-const |stop#4| Int)
(declare-const |src#1| (Seq Int))
(assert (! (>= |start#2| 0) :named |given.0|))
(assert (! (>= |stop#4| 0) :named |given.1|))
(assert (! (>= |start#2| 0) :named |fact.0|))
(assert (! (>= |stop#4| 0) :named |fact.1|))
(assert (! (< |start#2| |stop#4|) :named |fact.2|))
(assert (! (<= |stop#4| (seq.len |src#1|)) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|start#2| |stop#4| |src#1|))
