(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |mark#0| Int)
(declare-const |length#1| Int)
(declare-const |indent#2| Int)
(assert (! (>= |mark#0| 0) :named |given.0|))
(assert (! (>= |length#1| 0) :named |given.1|))
(assert (! (>= |indent#2| 0) :named |given.2|))
(assert (! (>= |mark#0| 0) :named |fact.0|))
(assert (! (>= |length#1| 0) :named |fact.1|))
(assert (! (>= |indent#2| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|mark#0| |length#1| |indent#2|))
