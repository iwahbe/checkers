(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |b#0| (Seq Int))
(declare-const |i#1| Int)
(declare-const |n#2| Int)
(assert (>= |i#1| 0))
(assert (>= (seq.nth |b#0| (+ |i#1| 1)) 0))
(assert (< (seq.nth |b#0| (+ |i#1| 1)) 256))
(assert (>= |n#2| 0))
(assert (>= (seq.nth |b#0| |i#1|) 0))
(assert (< (seq.nth |b#0| |i#1|) 256))
(assert (>= |i#1| 0))
(assert (>= |n#2| 0))
(assert (= (ite (not (> |n#2| 999)) (>= |i#1| (seq.len |b#0|)) true) false))
(assert (= (= (seq.nth |b#0| |i#1|) 93) false))
(assert (= (= (seq.nth |b#0| |i#1|) 91) false))
(assert (= (ite (not (= (seq.nth |b#0| |i#1|) 92)) false (< (+ |i#1| 1) (seq.len |b#0|))) true))
(assert (not (>= (seq.nth |b#0| (+ |i#1| 1)) 0)))
(check-sat)
(get-value (|b#0| |i#1| |n#2|))
