(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#first#0| Int)
(declare-const |#last#1| Int)
(declare-const |#start#2| Int)
(declare-const |#stop#3| Int)
(assert (! (>= |#first#0| 0) :named |given.0|))
(assert (! (>= |#last#1| 0) :named |given.1|))
(assert (! (>= |#start#2| 0) :named |given.2|))
(assert (! (>= |#stop#3| 0) :named |given.3|))
(assert (! (>= |#first#0| 0) :named |fact.0|))
(assert (! (>= |#last#1| 0) :named |fact.1|))
(assert (! (>= |#start#2| 0) :named |fact.2|))
(assert (! (>= |#stop#3| 0) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#first#0| |#last#1| |#start#2| |#stop#3|))
