(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |mark#1| Int)
(declare-const |start#2| Int)
(declare-const |offset#3| Int)
(declare-const |padding#4| Int)
(assert (! (>= |mark#1| 0) :named |given.0|))
(assert (! (>= |start#2| 0) :named |given.1|))
(assert (! (>= |offset#3| 0) :named |given.2|))
(assert (! (>= |padding#4| 0) :named |given.3|))
(assert (! (>= |mark#1| 0) :named |fact.0|))
(assert (! (>= |start#2| 0) :named |fact.1|))
(assert (! (>= |offset#3| 0) :named |fact.2|))
(assert (! (>= |padding#4| 0) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|mark#1| |start#2| |offset#3| |padding#4|))
