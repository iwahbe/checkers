(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |i#1| Int)
(declare-const |j#2| Int)
(declare-const |base#3| Int)
(declare-const |acc#4| Int)
(assert (! (>= |i#1| 0) :named |given.0|))
(assert (! (>= |j#2| 0) :named |given.1|))
(assert (! (>= |base#3| 0) :named |given.2|))
(assert (! (>= |acc#4| 0) :named |given.3|))
(assert (! (>= |i#1| 0) :named |fact.0|))
(assert (! (>= |j#2| 0) :named |fact.1|))
(assert (! (>= |base#3| 0) :named |fact.2|))
(assert (! (>= |acc#4| 0) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|i#1| |j#2| |base#3| |acc#4|))
