(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#start#0| Int)
(declare-const |#stop#1| Int)
(declare-const |#offset#2| Int)
(declare-const |#column#3| Int)
(assert (! (>= |#start#0| 0) :named |given.0|))
(assert (! (>= |#stop#1| 0) :named |given.1|))
(assert (! (>= |#offset#2| 0) :named |given.2|))
(assert (! (>= |#column#3| 0) :named |given.3|))
(assert (! (>= |#start#0| 0) :named |fact.0|))
(assert (! (>= |#stop#1| 0) :named |fact.1|))
(assert (! (>= |#offset#2| 0) :named |fact.2|))
(assert (! (>= |#column#3| 0) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#start#0| |#stop#1| |#offset#2| |#column#3|))
