(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#i#1| Int)
(declare-const |#col#2| Int)
(declare-const |#acc#3| Int)
(assert (! (>= |#i#1| 0) :named |given.0|))
(assert (! (>= |#col#2| 0) :named |given.1|))
(assert (! (>= |#acc#3| 0) :named |given.2|))
(assert (! (>= |#i#1| 0) :named |fact.0|))
(assert (! (>= |#col#2| 0) :named |fact.1|))
(assert (! (>= |#acc#3| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#i#1| |#col#2| |#acc#3|))
