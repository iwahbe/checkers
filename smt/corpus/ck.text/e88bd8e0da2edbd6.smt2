(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|ck.text.is_hex| ((p0 Int)) Bool)) ((ite (not (ite (not (>= p0 48)) false (<= p0 57))) (ite (not (ite (not (>= p0 97)) false (<= p0 102))) (ite (not (>= p0 65)) false (<= p0 70)) true) true)))
(declare-const |i#1| Int)
(declare-const |b#0| (Seq Int))
(assert (>= |i#1| 0))
(assert (>= (seq.nth |b#0| |i#1|) 0))
(assert (< (seq.nth |b#0| |i#1|) 256))
(assert (>= (seq.nth |b#0| (+ |i#1| 1)) 0))
(assert (< (seq.nth |b#0| (+ |i#1| 1)) 256))
(assert (>= (seq.nth |b#0| (+ |i#1| 2)) 0))
(assert (< (seq.nth |b#0| (+ |i#1| 2)) 256))
(assert (>= |i#1| 0))
(assert (= (>= |i#1| (seq.len |b#0|)) false))
(assert (= (ite (not (= (seq.nth |b#0| |i#1|) 37)) false (ite (not (< (+ |i#1| 2) (seq.len |b#0|))) false (ite (not (|ck.text.is_hex| (seq.nth |b#0| (+ |i#1| 1)))) false (|ck.text.is_hex| (seq.nth |b#0| (+ |i#1| 2)))))) false))
(assert (not (<= |i#1| (+ |i#1| 1))))
(check-sat)
(get-value (|i#1| |b#0|))
