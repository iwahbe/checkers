(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |s#0| (Seq Int))
(declare-const |suffix#1| (Seq Int))
(assert (= (<= (seq.len |suffix#1|) (seq.len |s#0|)) true))
(assert (not (>= (seq.len |s#0|) (seq.len |suffix#1|))))
(check-sat)
(get-value (|s#0| |suffix#1|))
