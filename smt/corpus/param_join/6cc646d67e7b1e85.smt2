(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|param_join.pick<Int>| ((p1 Int) (p2 Int)) Int)) (p2))
(declare-const |d#1| Int)
(declare-const |c#0| Int)
(assert (>= |d#1| 0))
(assert (>= |c#0| 0))
(assert (>= |c#0| 0))
(assert (>= |d#1| 0))
(assert (= (< |c#0| |d#1|) false))
(assert (not (<= (|param_join.pick<Int>| (- 8 (mod |d#1| 4)) (- 4 (mod |c#0| 4))) 8)))
(check-sat)
(get-value (|d#1| |c#0|))
