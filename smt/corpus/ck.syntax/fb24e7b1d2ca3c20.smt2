(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |i#1| Int)
(declare-const |e#2| Int)
(declare-const |depth#3| Int)
(declare-const |src#0| (Seq Int))
(assert (! (>= |i#1| 0) :named |given.0|))
(assert (! (>= |e#2| 0) :named |given.1|))
(assert (! (>= |depth#3| 0) :named |given.2|))
(assert (! (>= |i#1| 0) :named |fact.0|))
(assert (! (>= |e#2| 0) :named |fact.1|))
(assert (! (>= |depth#3| 0) :named |fact.2|))
(assert (! (<= |i#1| |e#2|) :named |fact.3|))
(assert (! (<= |e#2| (seq.len |src#0|)) :named |fact.4|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|i#1| |e#2| |depth#3| |src#0|))
