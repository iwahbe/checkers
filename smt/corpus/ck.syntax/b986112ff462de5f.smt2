(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |depth#1| Int)
(declare-const |col#3| Int)
(declare-const |open#4| Int)
(declare-const |line#5| Int)
(assert (! (>= |depth#1| 0) :named |given.0|))
(assert (! (>= |col#3| 0) :named |given.1|))
(assert (! (>= |open#4| 0) :named |given.2|))
(assert (! (>= |line#5| 0) :named |given.3|))
(assert (! (>= |depth#1| 0) :named |fact.0|))
(assert (! (>= |col#3| 0) :named |fact.1|))
(assert (! (>= |open#4| 0) :named |fact.2|))
(assert (! (>= |line#5| 0) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|depth#1| |col#3| |open#4| |line#5|))
