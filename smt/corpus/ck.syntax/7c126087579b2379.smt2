(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |i#0| Int)
(declare-const |e#1| Int)
(assert (! (>= |i#0| 0) :named |given.0|))
(assert (! (>= |e#1| 0) :named |given.1|))
(assert (! (>= |i#0| 0) :named |fact.0|))
(assert (! (>= |e#1| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|i#0| |e#1|))
