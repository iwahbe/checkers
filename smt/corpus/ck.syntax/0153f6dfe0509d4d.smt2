(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#col#2| Int)
(declare-const |#wide#3| Int)
(assert (! (>= |#col#2| 0) :named |given.0|))
(assert (! (>= |#wide#3| 0) :named |given.1|))
(assert (! (>= |#col#2| 0) :named |fact.0|))
(assert (! (>= |#wide#3| 0) :named |fact.1|))
