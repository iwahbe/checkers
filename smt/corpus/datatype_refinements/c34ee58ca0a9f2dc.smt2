(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |lo#0| Int)
(declare-const |hi#1| Int)
(assert (! (>= |lo#0| 0) :named |given.0|))
(assert (! (>= |hi#1| 0) :named |given.1|))
(assert (! (>= |lo#0| 0) :named |fact.0|))
(assert (! (>= |hi#1| 0) :named |fact.1|))
(assert (! (<= |lo#0| |hi#1|) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|lo#0| |hi#1|))
