(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|std.char.is_digit| ((p0 Int)) Bool)) ((ite (not (<= 48 p0)) false (<= p0 57))))
(declare-const |b#0| (Seq Int))
(assert (>= (seq.nth |b#0| 0) 0))
(assert (< (seq.nth |b#0| 0) 256))
(assert (> (seq.len |b#0|) 0))
(assert (|std.char.is_digit| (seq.nth |b#0| 0)))
(assert (not (|std.char.is_digit| (seq.nth |b#0| 0))))
(check-sat)
(get-value (|b#0|))
