(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |bytes#0| Int)
(declare-const |holes#1| Int)
(assert (! (>= |bytes#0| 0) :named |given.0|))
(assert (! (>= |holes#1| 0) :named |given.1|))
(assert (! (>= |bytes#0| 0) :named |fact.0|))
(assert (! (>= |holes#1| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|bytes#0| |holes#1|))
