(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |#std.prelude.string_le| ((Seq Int) (Seq Int)) Bool)
(declare-fun |#std.prelude.valid_utf8| ((Seq Int)) Bool)
(define-funs-rec ((|#std.prelude.Ord String.le| ((p0 (Seq Int)) (p1 (Seq Int))) Bool) (|#std.math.min<(Seq Int)>[std.prelude.Ord String]| ((p2 (Seq Int)) (p3 (Seq Int))) (Seq Int)) (|#math_order.lower<(Seq Int)>[std.prelude.Ord String]| ((p2 (Seq Int)) (p3 (Seq Int))) (Seq Int))) ((|#std.prelude.string_le| p0 p1) (ite (not (|#std.prelude.Ord String.le| p2 p3)) p3 p2) (|#std.math.min<(Seq Int)>[std.prelude.Ord String]| p2 p3)))
(declare-const |#s#0| (Seq Int))
(declare-const |#t#1| (Seq Int))
(assert (|#std.prelude.valid_utf8| |#s#0|))
(assert (|#std.prelude.valid_utf8| |#t#1|))
(assert (|#std.prelude.Ord String.le| (|#math_order.lower<(Seq Int)>[std.prelude.Ord String]| |#s#0| |#t#1|) |#s#0|))
(assert (|#std.prelude.Ord String.le| (|#math_order.lower<(Seq Int)>[std.prelude.Ord String]| |#s#0| |#t#1|) |#t#1|))
(assert (not (|#std.prelude.Ord String.le| (|#math_order.lower<(Seq Int)>[std.prelude.Ord String]| |#s#0| |#t#1|) |#s#0|)))
(check-sat)
(get-value (|#s#0| |#t#1|))
