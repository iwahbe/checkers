(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |k#1| Int)
(declare-const |start#5| Int)
(assert (! (>= |k#1| 0) :named |given.0|))
(assert (! (>= |start#5| 0) :named |given.1|))
(assert (! (>= |k#1| 0) :named |fact.0|))
(assert (! (>= |start#5| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|k#1| |start#5|))
