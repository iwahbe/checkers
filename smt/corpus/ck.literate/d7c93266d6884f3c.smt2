(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |a#0| Int)
(declare-const |b#1| Int)
(declare-const |c#2| Int)
(assert (! (>= |a#0| 0) :named |given.0|))
(assert (! (>= |b#1| 0) :named |given.1|))
(assert (! (>= |c#2| 0) :named |given.2|))
(assert (! (>= |a#0| 0) :named |fact.0|))
(assert (! (>= |b#1| 0) :named |fact.1|))
(assert (! (>= |c#2| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|a#0| |b#1| |c#2|))
