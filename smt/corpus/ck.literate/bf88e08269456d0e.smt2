(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-fun |ck.literate.trim| ((Seq Int)) (Seq Int))
(declare-const |label#0| (Seq Int))
(assert (< (seq.nth (|ck.literate.trim| |label#0|) 0) 256))
(assert (>= (seq.nth (|ck.literate.trim| |label#0|) 0) 0))
(assert (= (> (seq.len (|ck.literate.trim| |label#0|)) 2) true))
(assert (= (= (seq.nth (|ck.literate.trim| |label#0|) 0) 96) true))
(assert (not (< (- (seq.len (|ck.literate.trim| |label#0|)) 1) (seq.len (|ck.literate.trim| |label#0|)))))
(check-sat)
(get-value (|label#0|))
