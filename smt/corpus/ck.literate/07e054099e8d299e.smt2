(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |c#0| Int)
(declare-const |j#2| Int)
(assert (! (>= |c#0| 0) :named |given.0|))
(assert (! (< |c#0| 256) :named |given.1|))
(assert (! (>= |j#2| 0) :named |given.2|))
(assert (! (< |c#0| 256) :named |fact.0|))
(assert (! (>= |j#2| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|c#0| |j#2|))
