(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |std.bytes.slice| ((Seq Int) Int Int) (Seq Int))
(declare-fun |std.prelude.valid_utf8| ((Seq Int)) Bool)
(define-funs-rec ((|ck.literate.starts| ((p0 (Seq Int)) (p1 (Seq Int))) Bool) (|ck.literate.from| ((p0 (Seq Int)) (p1 Int)) (Seq Int))) ((and (<= (+ 0 (seq.len p1)) (seq.len p0)) (= (seq.extract p0 0 (seq.len p1)) p1)) (ite (not (<= p1 (seq.len p0))) (as seq.empty (Seq Int)) (|std.bytes.slice| p0 p1 (seq.len p0)))))
(declare-const |b#0| (Seq Int))
(assert (|std.prelude.valid_utf8| (seq.unit 124)))
(assert (= (> (seq.len (ite (not (|ck.literate.starts| |b#0| (seq.unit 124))) |b#0| (|ck.literate.from| |b#0| 1))) 0) true))
(assert (not (< (- (seq.len (ite (not (|ck.literate.starts| |b#0| (seq.unit 124))) |b#0| (|ck.literate.from| |b#0| 1))) 1) (seq.len (ite (not (|ck.literate.starts| |b#0| (seq.unit 124))) |b#0| (|ck.literate.from| |b#0| 1))))))
(check-sat)
(get-value (|b#0|))
