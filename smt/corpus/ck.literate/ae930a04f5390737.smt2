(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |offset#1| Int)
(declare-const |i#2| Int)
(declare-const |line#3| Int)
(declare-const |start#4| Int)
(assert (! (>= |offset#1| 0) :named |given.0|))
(assert (! (>= |i#2| 0) :named |given.1|))
(assert (! (>= |line#3| 0) :named |given.2|))
(assert (! (>= |start#4| 0) :named |given.3|))
(assert (! (>= |offset#1| 0) :named |fact.0|))
(assert (! (>= |i#2| 0) :named |fact.1|))
(assert (! (>= |line#3| 0) :named |fact.2|))
(assert (! (>= |start#4| 0) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|offset#1| |i#2| |line#3| |start#4|))
