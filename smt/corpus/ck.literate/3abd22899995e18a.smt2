(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |b#0| (Seq Int))
(declare-const |j#1| Int)
(assert (>= |j#1| 0))
(assert (>= (seq.nth |b#0| (- |j#1| 1)) 0))
(assert (< (seq.nth |b#0| (- |j#1| 1)) 256))
(assert (>= |j#1| 0))
(assert (= (> |j#1| 0) true))
(assert (= (<= |j#1| (seq.len |b#0|)) true))
(assert (not (< (seq.nth |b#0| (- |j#1| 1)) 256)))
(check-sat)
(get-value (|b#0| |j#1|))
