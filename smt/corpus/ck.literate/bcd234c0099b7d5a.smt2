(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|#ck.literate.is_name_start| ((p0 Int)) Bool) (|#ck.literate.is_name_char| ((p0 Int)) Bool)) ((ite (not (ite (not (>= p0 97)) false (<= p0 122))) (ite (not (ite (not (>= p0 65)) false (<= p0 90))) (= p0 95) true) true) (ite (not (|#ck.literate.is_name_start| p0)) (ite (not (>= p0 48)) false (<= p0 57)) true)))
(declare-const |#i#1| Int)
(declare-const |#b#0| (Seq Int))
(assert (>= |#i#1| 0))
(assert (>= (seq.nth |#b#0| |#i#1|) 0))
(assert (< (seq.nth |#b#0| |#i#1|) 256))
(assert (>= |#i#1| 0))
(assert (= (< |#i#1| (seq.len |#b#0|)) true))
(assert (= (|#ck.literate.is_name_char| (seq.nth |#b#0| |#i#1|)) false))
(assert (not (< |#i#1| (seq.len |#b#0|))))
(check-sat)
(get-value (|#i#1| |#b#0|))
