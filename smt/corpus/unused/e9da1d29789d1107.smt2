(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |width#0| Int)
(declare-const |height#1| Int)
(assert (! (>= |width#0| 0) :named |given.0|))
(assert (! (>= |height#1| 0) :named |given.1|))
(assert (! (>= |width#0| 0) :named |fact.0|))
(assert (! (>= |height#1| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|width#0| |height#1|))
