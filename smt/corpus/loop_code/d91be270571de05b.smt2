(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |#std.hint.blackbox<(Seq Int)>| ((Seq Int)) (Seq Int))
(declare-fun |#std.hint.blackbox<Int>| (Int) Int)
(declare-fun |#std.prelude.valid_utf8| ((Seq Int)) Bool)
(assert (|#std.prelude.valid_utf8| (seq.++ (seq.unit 97) (seq.unit 98) (seq.unit 99))))
(assert (= (|#std.hint.blackbox<Int>| 0) 0))
(assert (= (|#std.hint.blackbox<(Seq Int)>| (seq.++ (seq.unit 97) (seq.unit 98) (seq.unit 99))) (seq.++ (seq.unit 97) (seq.unit 98) (seq.unit 99))))
(assert (not (<= (|#std.hint.blackbox<Int>| 0) (seq.len (|#std.hint.blackbox<(Seq Int)>| (seq.++ (seq.unit 97) (seq.unit 98) (seq.unit 99)))))))
(check-sat)
