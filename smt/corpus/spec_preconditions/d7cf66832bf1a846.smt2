(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |#x#0| Int)
(declare-const |#r#1| Int)
(assert (>= |#x#0| 0))
(assert (>= |#r#1| 0))
(assert (>= |#x#0| 0))
(assert (>= |#r#1| 0))
(assert (>= |#x#0| 1))
(assert (not (>= |#x#0| 1)))
(check-sat)
(get-value (|#x#0| |#r#1|))
