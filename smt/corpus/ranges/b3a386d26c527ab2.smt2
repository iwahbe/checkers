(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |q#0| Int)
(declare-const |e#1| Int)
(assert (! (>= |q#0| 0) :named |given.0|))
(assert (! (< |q#0| 256) :named |given.1|))
(assert (! (>= |e#1| 0) :named |given.2|))
(assert (! (< |q#0| 256) :named |fact.0|))
(assert (! (< (+ |q#0| 1) |e#1|) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|q#0| |e#1|))
