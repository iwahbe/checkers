(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |parent#1| Int)
(declare-const |blanks#2| Int)
(declare-const |m#3| Int)
(assert (! (>= |parent#1| 0) :named |given.0|))
(assert (! (>= |blanks#2| 0) :named |given.1|))
(assert (! (>= |m#3| 0) :named |given.2|))
(assert (! (>= |parent#1| 0) :named |fact.0|))
(assert (! (>= |blanks#2| 0) :named |fact.1|))
(assert (! (>= |m#3| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|parent#1| |blanks#2| |m#3|))
