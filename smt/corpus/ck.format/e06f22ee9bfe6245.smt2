(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |width#1| Int)
(declare-const |gap#3| Int)
(assert (! (>= |width#1| 0) :named |given.0|))
(assert (! (>= |gap#3| 0) :named |given.1|))
(assert (! (>= |width#1| 0) :named |fact.0|))
(assert (! (>= |gap#3| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|width#1| |gap#3|))
