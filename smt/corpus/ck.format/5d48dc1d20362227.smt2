(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |parent#0| Int)
(declare-const |blanks#1| Int)
(assert (! (>= |parent#0| 0) :named |given.0|))
(assert (! (>= |blanks#1| 0) :named |given.1|))
(assert (! (>= |parent#0| 0) :named |fact.0|))
(assert (! (>= |blanks#1| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|parent#0| |blanks#1|))
