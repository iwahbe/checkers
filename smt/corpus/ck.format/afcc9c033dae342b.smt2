(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |indent#2| Int)
(declare-const |origin#3| Int)
(assert (! (>= |indent#2| 0) :named |given.0|))
(assert (! (>= |origin#3| 0) :named |given.1|))
(assert (! (>= |indent#2| 0) :named |fact.0|))
(assert (! (>= |origin#3| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|indent#2| |origin#3|))
