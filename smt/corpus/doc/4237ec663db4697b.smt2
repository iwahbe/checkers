(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-fun |std.prelude.valid_utf8| ((Seq Int)) Bool)
(declare-const |path#0| (Seq Int))
(assert (|std.prelude.valid_utf8| |path#0|))
(assert (>= (seq.nth |path#0| (- (seq.len |path#0|) 1)) 0))
(assert (< (seq.nth |path#0| (- (seq.len |path#0|) 1)) 256))
(assert (= (ite (not (> (seq.len |path#0|) 1)) false (= (seq.nth |path#0| (- (seq.len |path#0|) 1)) 47)) true))
(assert (not (<= 0 (- (seq.len |path#0|) 1))))
(check-sat)
(get-value (|path#0|))
