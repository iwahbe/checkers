(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#start#1| Int)
(declare-const |#j#2| Int)
(assert (! (>= |#start#1| 0) :named |given.0|))
(assert (! (>= |#j#2| 0) :named |given.1|))
(assert (! (>= |#start#1| 0) :named |fact.0|))
(assert (! (>= |#j#2| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#start#1| |#j#2|))
