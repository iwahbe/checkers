(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |line#2| Int)
(declare-const |col#3| Int)
(assert (! (>= |line#2| 0) :named |given.0|))
(assert (! (>= |col#3| 0) :named |given.1|))
(assert (! (>= |line#2| 0) :named |fact.0|))
(assert (! (>= |col#3| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|line#2| |col#3|))
