(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |at#1| Int)
(declare-const |best#2| Int)
(assert (! (>= |at#1| 0) :named |given.0|))
(assert (! (>= |best#2| 0) :named |given.1|))
(assert (! (>= |at#1| 0) :named |fact.0|))
(assert (! (>= |best#2| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|at#1| |best#2|))
