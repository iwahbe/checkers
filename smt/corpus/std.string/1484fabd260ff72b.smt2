(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |n#0| Int)
(declare-const |base#1| Int)
(assert (! (>= |n#0| 0) :named |given.0|))
(assert (! (>= |base#1| 0) :named |given.1|))
(assert (! (>= |n#0| 0) :named |fact.0|))
(assert (! (>= |base#1| 0) :named |fact.1|))
(assert (! (<= 2 |base#1|) :named |fact.2|))
(assert (! (<= |base#1| 36) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|n#0| |base#1|))
