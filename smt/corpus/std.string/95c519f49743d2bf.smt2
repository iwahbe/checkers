(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|std.prelude.not| ((p0 Bool)) Bool) (|std.char.is_digit| ((p0 Int)) Bool)) ((ite (not p0) true false) (ite (not (<= 48 p0)) false (<= p0 57))))
(declare-const |n#0| Int)
(declare-const |post#1| (Seq Int))
(assert (>= (seq.nth |post#1| 0) 0))
(assert (< (seq.nth |post#1| 0) 256))
(assert (ite (not (= (seq.len |post#1|) 0)) (|std.prelude.not| (|std.char.is_digit| (seq.nth |post#1| 0))) true))
(assert (= (< |n#0| 0) true))
(assert (not (>= (- |n#0|) 0)))
(check-sat)
(get-value (|n#0| |post#1|))
