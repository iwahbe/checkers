(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-fun |#std.string.all_digits#outside| ((Seq Int) Int Int) Bool)
(declare-fun |#std.char.is_digit| (Int) Bool)
(declare-fun |#std.string.all_digits| ((Seq Int) Int Int) Bool)
(declare-const |#i#1| Int)
(declare-const |#j#2| Int)
(declare-const |#b#0| (Seq Int))
(assert (! (>= |#i#1| 0) :named |given.0|))
(assert (! (>= |#j#2| 0) :named |given.1|))
(assert (! (>= |#i#1| 0) :named |fact.0|))
(assert (! (>= |#j#2| 0) :named |fact.1|))
(assert (! (<= |#i#1| |#j#2|) :named |fact.2|))
(assert (! (<= |#j#2| (seq.len |#b#0|)) :named |fact.3|))
(assert (! (|#std.string.all_digits| |#b#0| |#i#1| |#j#2|) :named |fact.4|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#i#1| |#j#2| |#b#0|))
