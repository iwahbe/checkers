(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |base#1| Int)
(declare-const |least#3| Int)
(assert (! (>= |base#1| 0) :named |given.0|))
(assert (! (>= |least#3| 0) :named |given.1|))
(assert (! (>= |base#1| 0) :named |fact.0|))
(assert (! (>= |least#3| 0) :named |fact.1|))
(assert (! (<= 2 |base#1|) :named |fact.2|))
(assert (! (<= |base#1| 36) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|base#1| |least#3|))
