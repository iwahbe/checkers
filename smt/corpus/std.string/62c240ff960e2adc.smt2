(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-fun |std.string.all_digits#outside| ((Seq Int) Int Int) Bool)
(define-funs-rec ((|std.char.is_digit| ((p0 Int)) Bool) (|std.string.all_digits| ((p0 (Seq Int)) (p1 Int) (p2 Int)) Bool)) ((ite (not (<= 48 p0)) false (<= p0 57)) (ite (and (>= p1 0) (>= p2 0)) (ite (not (<= p2 p1)) (ite (not (<= p2 (seq.len p0))) false (ite (not (|std.string.all_digits| p0 p1 (- p2 1))) false (|std.char.is_digit| (seq.nth p0 (- p2 1))))) true) (|std.string.all_digits#outside| p0 p1 p2))))
(declare-const |j#2| Int)
(declare-const |b#0| (Seq Int))
(declare-const |i#1| Int)
(assert (>= |j#2| 0))
(assert (>= |i#1| 0))
(assert (>= |i#1| 0))
(assert (>= |j#2| 0))
(assert (<= |i#1| |j#2|))
(assert (<= |j#2| (seq.len |b#0|)))
(assert (|std.string.all_digits| |b#0| |i#1| |j#2|))
(assert (not (<= |j#2| (seq.len |b#0|))))
(check-sat)
(get-value (|j#2| |b#0| |i#1|))
