(set-option :produce-models true)
(set-option :rlimit 6000000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|std.char.is_digit| ((p0 Int)) Bool)) ((ite (not (<= 48 p0)) false (<= p0 57))))
(declare-const |k#3| Int)
(declare-const |j#2| Int)
(declare-const |b#0| (Seq Int))
(assert (>= |k#3| 0))
(assert (>= |j#2| 0))
(assert (>= (seq.nth |b#0| |j#2|) 0))
(assert (< (seq.nth |b#0| |j#2|) 256))
(assert (= (< |j#2| |k#3|) true))
(assert (ite (not (< |j#2| (seq.len |b#0|))) false (|std.char.is_digit| (seq.nth |b#0| |j#2|))))
(assert (not (< (- |k#3| (+ |j#2| 1)) (- |k#3| |j#2|))))
(check-sat)
(get-value (|k#3| |j#2| |b#0|))
