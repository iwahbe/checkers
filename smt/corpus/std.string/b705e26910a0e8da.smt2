(assert (=> (and (>= (+ |#i#1| 1) 0) (<= (+ |#i#1| 1) (seq.len |#b#0|))) (>= (|#std.string.digits_end| |#b#0| (+ |#i#1| 1)) 0)))
(assert (=> (and (>= (+ |#i#1| 1) 0) (<= (+ |#i#1| 1) (seq.len |#b#0|))) (<= (+ |#i#1| 1) (|#std.string.digits_end| |#b#0| (+ |#i#1| 1)))))
(assert (=> (and (>= (+ |#i#1| 1) 0) (<= (+ |#i#1| 1) (seq.len |#b#0|))) (<= (|#std.string.digits_end| |#b#0| (+ |#i#1| 1)) (seq.len |#b#0|))))
