(set-option :produce-models true)
(set-option :rlimit 6000000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |n#0| Int)
(declare-const |base#1| Int)
(assert (>= |n#0| 0))
(assert (>= |base#1| 0))
(assert (= (< |n#0| |base#1|) false))
(assert (not (< (div |n#0| |base#1|) |n#0|)))
(check-sat)
(get-value (|n#0| |base#1|))
