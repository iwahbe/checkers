(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |i#1| Int)
(declare-const |j#2| Int)
(assert (! (>= |i#1| 0) :named |given.0|))
(assert (! (>= |j#2| 0) :named |given.1|))
(assert (! (>= |i#1| 0) :named |fact.0|))
(assert (! (>= |j#2| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|i#1| |j#2|))
