(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |major#0| Int)
(declare-const |minor#1| Int)
(assert (! (>= |major#0| 0) :named |given.0|))
(assert (! (>= |minor#1| 0) :named |given.1|))
(assert (! (>= |major#0| 0) :named |fact.0|))
(assert (! (>= |minor#1| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|major#0| |minor#1|))
