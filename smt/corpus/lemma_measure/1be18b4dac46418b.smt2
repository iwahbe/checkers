(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 6000000)
(set-logic ALL)
(declare-const |#n#0| Int)
(declare-const |#x#1| Int)
(assert (>= |#n#0| 0))
(assert (>= |#x#1| 0))
(assert (= (< |#x#1| |#n#0|) true))
(assert (not (< (- |#n#0| (+ |#x#1| 1)) (- |#n#0| |#x#1|))))
(check-sat)
(get-value (|#n#0| |#x#1|))
