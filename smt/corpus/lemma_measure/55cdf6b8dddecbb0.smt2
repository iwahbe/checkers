(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |x#1| Int)
(declare-const |n#0| Int)
(assert (>= |x#1| 0))
(assert (>= |n#0| 0))
(assert (>= |n#0| 0))
(assert (>= |x#1| 0))
(assert (<= |x#1| |n#0|))
(assert (not (<= |x#1| |n#0|)))
(check-sat)
(get-value (|x#1| |n#0|))
