(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |n#3| Int)
(declare-const |x#4| Int)
(assert (! (>= |n#3| 0) :named |given.0|))
(assert (! (>= |x#4| 0) :named |given.1|))
(assert (! (>= |n#3| 0) :named |fact.0|))
(assert (! (>= |x#4| 0) :named |fact.1|))
(assert (! (<= |x#4| |n#3|) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|n#3| |x#4|))
