(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |x#2| Int)
(declare-const |n#1| Int)
(assert (>= |x#2| 0))
(assert (>= |n#1| 0))
(assert (>= |n#1| 0))
(assert (>= |x#2| 0))
(assert (<= |x#2| |n#1|))
(assert (= (< |x#2| |n#1|) true))
(assert (not (<= (+ |x#2| 1) |n#1|)))
(check-sat)
(get-value (|x#2| |n#1|))
