(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |#pre#0| (Seq Int))
(declare-const |#mid#1| (Seq Int))
(declare-const |#post#2| (Seq Int))
(assert (not (<= (+ (seq.len |#pre#0|) (seq.len |#mid#1|)) (seq.len (seq.++ (seq.++ |#pre#0| |#mid#1|) |#post#2|)))))
(check-sat)
(get-value (|#pre#0| |#mid#1| |#post#2|))
