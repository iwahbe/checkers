(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |xs#0| (Seq Int))
(declare-const |ys#1| (Seq Int))
(declare-const |ext.index| Int)
(assert (>= (seq.nth |xs#0| |ext.index|) 0))
(assert (< (seq.nth |xs#0| |ext.index|) 256))
(assert (>= (seq.nth |ys#1| |ext.index|) 0))
(assert (< (seq.nth |ys#1| |ext.index|) 256))
(assert (=> (and (<= 0 |ext.index|) (< |ext.index| (seq.len |xs#0|))) (=> (>= |ext.index| 0) (ite (not (< |ext.index| (seq.len |xs#0|))) true (= (seq.nth |xs#0| |ext.index|) (seq.nth |ys#1| |ext.index|))))))
(assert (= (seq.len |xs#0|) (seq.len |ys#1|)))
(assert (not (or (= |xs#0| |ys#1|) (and (= (seq.len |xs#0|) (seq.len |ys#1|)) (=> (and (<= 0 |ext.index|) (< |ext.index| (seq.len |xs#0|))) (= (seq.nth |xs#0| |ext.index|) (seq.nth |ys#1| |ext.index|)))))))
(check-sat)
(get-value (|xs#0| |ys#1|))
