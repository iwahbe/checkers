(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|forall_hyps.ordered[*]| ((p0 (Array Int (Array Int Bool))) (p1 Int) (p2 Int)) Bool)) ((ite (not (select (select p0 p1) p2)) (select (select p0 p2) p1) true)))
(declare-const |le#0| (Array Int (Array Int Bool)))
(declare-const |x#1| Int)
(assert (|forall_hyps.ordered[*]| |le#0| |x#1| |x#1|))
(assert (not (|forall_hyps.ordered[*]| |le#0| |x#1| |x#1|)))
(check-sat)
(get-value (|x#1|))
