(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |#std.prelude.valid_utf8| ((Seq Int)) Bool)
(declare-fun |#std.string.from_char| (Int) (Seq Int))
(assert (|#std.prelude.valid_utf8| (seq.unit 120)))
(assert (not (|#std.prelude.valid_utf8| (seq.unit 128))))
(assert (not (<= 1 (seq.len (seq.++ (seq.++ (seq.unit 120) (|#std.string.from_char| 8364)) (seq.unit 128))))))
(check-sat)
