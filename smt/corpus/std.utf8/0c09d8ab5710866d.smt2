(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |std.prelude.valid_utf8| ((Seq Int)) Bool)
(declare-const |a#0| (Seq Int))
(declare-const |b#1| (Seq Int))
(declare-const |ext.index| Int)
(assert (|std.prelude.valid_utf8| |a#0|))
(assert (|std.prelude.valid_utf8| |b#1|))
(assert (not (or (= (seq.++ |a#0| |b#1|) (seq.++ |a#0| |b#1|)) (and (= (seq.len (seq.++ |a#0| |b#1|)) (seq.len (seq.++ |a#0| |b#1|))) (=> (and (<= 0 |ext.index|) (< |ext.index| (seq.len (seq.++ |a#0| |b#1|)))) (= (seq.nth (seq.++ |a#0| |b#1|) |ext.index|) (seq.nth (seq.++ |a#0| |b#1|) |ext.index|)))))))
(check-sat)
(get-value (|a#0| |b#1|))
