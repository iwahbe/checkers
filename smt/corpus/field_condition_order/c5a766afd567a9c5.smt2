(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-fun |field_condition_order.pred| (Int Int) Bool)
(declare-const |start#0| Int)
(declare-const |stop#1| Int)
(assert (! (>= |start#0| 0) :named |given.0|))
(assert (! (>= |stop#1| 0) :named |given.1|))
(assert (! (>= |start#0| 0) :named |fact.0|))
(assert (! (>= |stop#1| 0) :named |fact.1|))
(assert (! (|field_condition_order.pred| |start#0| |stop#1|) :named |fact.2|))
(assert (! (<= |start#0| |stop#1|) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|start#0| |stop#1|))
