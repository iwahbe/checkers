(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-fun |#std.prelude.valid_utf8| ((Seq Int)) Bool)
(declare-const |#x#0| (Seq Int))
(declare-const |#y#1| (Seq Int))
(assert (! (|#std.prelude.valid_utf8| |#x#0|) :named |given.0|))
(assert (! (|#std.prelude.valid_utf8| |#y#1|) :named |given.1|))
(assert (! (< (seq.len |#x#0|) (seq.len |#y#1|)) :named |fact.0|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#x#0| |#y#1|))
