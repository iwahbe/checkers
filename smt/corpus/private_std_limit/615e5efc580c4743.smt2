(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |#std.prelude.string_le| ((Seq Int) (Seq Int)) Bool)
(declare-fun |#std.prelude.valid_utf8| ((Seq Int)) Bool)
(define-funs-rec ((|#std.prelude.Ord String.le| ((p0 (Seq Int)) (p1 (Seq Int))) Bool)) ((|#std.prelude.string_le| p0 p1)))
(declare-const |#x#0| (Seq Int))
(declare-const |#y#1| (Seq Int))
(assert (|#std.prelude.valid_utf8| |#x#0|))
(assert (|#std.prelude.valid_utf8| |#y#1|))
(assert (< (seq.len |#x#0|) (seq.len |#y#1|)))
(assert (not (|#std.prelude.Ord String.le| |#x#0| |#y#1|)))
(check-sat)
(get-value (|#x#0| |#y#1|))
