(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |xs#0| (Seq Int))
(declare-const |i#1| Int)
(assert (>= |i#1| 0))
(assert (>= (seq.nth |xs#0| |i#1|) 0))
(assert (>= (seq.nth |xs#0| (+ |i#1| 1)) 0))
(assert (> (seq.len |xs#0|) 0))
(assert (< |i#1| (- (seq.len |xs#0|) 1)))
(assert (not (>= (+ (seq.nth |xs#0| |i#1|) (seq.nth |xs#0| (+ |i#1| 1))) 0)))
(check-sat)
(get-value (|xs#0| |i#1|))
