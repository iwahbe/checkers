(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |n#1| Int)
(declare-const |n#0| Int)
(assert (>= |n#1| 0))
(assert (>= |n#0| 0))
(assert (< |n#1| |n#0|))
(assert (>= |n#0| 0))
(assert (not (>= |n#1| 0)))
(check-sat)
(get-value (|n#0| |n#1|))
