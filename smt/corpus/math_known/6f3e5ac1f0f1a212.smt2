(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|#std.prelude.Ord Int.le| ((p0 Int) (p1 Int)) Bool) (|#std.math.max<Int>[std.prelude.Ord Int]| ((p2 Int) (p3 Int)) Int)) ((<= p0 p1) (ite (not (|#std.prelude.Ord Int.le| p3 p2)) p3 p2)))
(declare-const |#y#1| Int)
(declare-const |#x#0| Int)
(assert (not (<= |#y#1| (|#std.math.max<Int>[std.prelude.Ord Int]| |#x#0| |#y#1|))))
(check-sat)
(get-value (|#y#1| |#x#0|))
