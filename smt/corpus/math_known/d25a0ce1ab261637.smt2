(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |std.math.pow#outside| (Int Int) Int)
(define-funs-rec ((|std.math.pow| ((p0 Int) (p1 Int)) Int)) ((ite (>= p1 0) (ite (not (= p1 0)) (* p0 (|std.math.pow| p0 (- p1 1))) 1) (|std.math.pow#outside| p0 p1))))
(declare-const |r#0| Int)
(declare-const |f#1| Int)
(assert (>= |r#0| 0))
(assert (>= |f#1| 0))
(assert (=> (>= |f#1| 0) (ite (not (>= 10 0)) true (>= (|std.math.pow| 10 |f#1|) 0))))
(assert (=> (>= |f#1| 0) (ite (not (> 10 0)) true (> (|std.math.pow| 10 |f#1|) 0))))
(assert (>= |r#0| 0))
(assert (>= |f#1| 0))
(assert (not (>= (div |r#0| (|std.math.pow| 10 |f#1|)) 0)))
(check-sat)
(get-value (|r#0| |f#1|))
