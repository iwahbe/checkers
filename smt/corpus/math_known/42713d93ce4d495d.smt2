(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-fun |std.math.pow#outside| (Int Int) Int)
(define-funs-rec ((|std.math.pow| ((p0 Int) (p1 Int)) Int)) ((ite (>= p1 0) (ite (not (= p1 0)) (* p0 (|std.math.pow| p0 (- p1 1))) 1) (|std.math.pow#outside| p0 p1))))
(declare-const |n#0| Int)
(declare-const |k#1| Int)
(assert (>= |k#1| 0))
(assert (=> (>= |k#1| 0) (ite (not (>= |n#0| 0)) true (>= (|std.math.pow| |n#0| |k#1|) 0))))
(assert (=> (>= |k#1| 0) (ite (not (> |n#0| 0)) true (> (|std.math.pow| |n#0| |k#1|) 0))))
(assert (=> (>= (- |k#1| 1) 0) (ite (not (>= |n#0| 0)) true (>= (|std.math.pow| |n#0| (- |k#1| 1)) 0))))
(assert (=> (>= (- |k#1| 1) 0) (ite (not (> |n#0| 0)) true (> (|std.math.pow| |n#0| (- |k#1| 1)) 0))))
(assert (>= |k#1| 0))
(assert (>= |n#0| 2))
(assert (= (> |k#1| 0) true))
(assert (> (|std.math.pow| |n#0| (- |k#1| 1)) (- |k#1| 1)))
(assert (not (> (|std.math.pow| |n#0| |k#1|) |k#1|)))
(check-sat)
(get-value (|n#0| |k#1|))
