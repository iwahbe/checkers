(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |k#1| Int)
(declare-const |n#0| Int)
(assert (! (>= |k#1| 0) :named |given.0|))
(assert (! (>= |k#1| 0) :named |fact.0|))
(assert (! (> |n#0| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|k#1| |n#0|))
