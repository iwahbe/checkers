(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|std.prelude.Ord Int.le| ((p0 Int) (p1 Int)) Bool) (|std.math.min<Int>[std.prelude.Ord Int]| ((p2 Int) (p3 Int)) Int)) ((<= p0 p1) (ite (not (|std.prelude.Ord Int.le| p2 p3)) p3 p2)))
(declare-const |x#0| Int)
(declare-const |y#1| Int)
(assert (not (<= (|std.math.min<Int>[std.prelude.Ord Int]| |x#0| |y#1|) |x#0|)))
(check-sat)
(get-value (|x#0| |y#1|))
