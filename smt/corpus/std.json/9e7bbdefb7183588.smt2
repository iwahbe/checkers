(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |total#1| Int)
(declare-const |depth#2| Int)
(declare-const |xs#0| (Seq Int))
(assert (! (>= |total#1| 0) :named |given.0|))
(assert (! (>= |depth#2| 0) :named |given.1|))
(assert (! (>= |total#1| 0) :named |fact.0|))
(assert (! (>= |depth#2| 0) :named |fact.1|))
(assert (! (<= (seq.len |xs#0|) |total#1|) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|total#1| |depth#2| |xs#0|))
