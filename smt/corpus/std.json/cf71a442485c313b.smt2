(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|std.json.hex_digit| ((p0 Int)) Bool)) ((ite (not (ite (not (<= 48 p0)) false (<= p0 57))) (ite (not (ite (not (<= 97 p0)) false (<= p0 102))) (ite (not (<= 65 p0)) false (<= p0 70)) true) true)))
(declare-const |src#0| (Seq Int))
(declare-const |i#1| Int)
(assert (>= |i#1| 0))
(assert (>= |i#1| 0))
(assert (>= (seq.nth |src#0| (+ |i#1| 2)) 0))
(assert (< (seq.nth |src#0| (+ |i#1| 2)) 256))
(assert (>= (seq.nth |src#0| (+ |i#1| 2)) 0))
(assert (>= (seq.nth |src#0| |i#1|) 0))
(assert (< (seq.nth |src#0| |i#1|) 256))
(assert (>= (seq.nth |src#0| |i#1|) 0))
(assert (>= (seq.nth |src#0| (+ |i#1| 1)) 0))
(assert (< (seq.nth |src#0| (+ |i#1| 1)) 256))
(assert (>= (seq.nth |src#0| (+ |i#1| 1)) 0))
(assert (>= (seq.nth |src#0| (+ |i#1| 3)) 0))
(assert (< (seq.nth |src#0| (+ |i#1| 3)) 256))
(assert (>= (seq.nth |src#0| (+ |i#1| 3)) 0))
(assert (>= |i#1| 0))
(assert (<= |i#1| (seq.len |src#0|)))
(assert (= (ite (not (<= (+ |i#1| 4) (seq.len |src#0|))) false (ite (not (|std.json.hex_digit| (seq.nth |src#0| |i#1|))) false (ite (not (|std.json.hex_digit| (seq.nth |src#0| (+ |i#1| 1)))) false (ite (not (|std.json.hex_digit| (seq.nth |src#0| (+ |i#1| 2)))) false (|std.json.hex_digit| (seq.nth |src#0| (+ |i#1| 3))))))) true))
(assert (not (|std.json.hex_digit| (seq.nth |src#0| (+ |i#1| 2)))))
(check-sat)
(get-value (|src#0| |i#1|))
