(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|std.json.hex_digit| ((p0 Int)) Bool)) ((ite (not (ite (not (<= 48 p0)) false (<= p0 57))) (ite (not (ite (not (<= 97 p0)) false (<= p0 102))) (ite (not (<= 65 p0)) false (<= p0 70)) true) true)))
(declare-const |b#0| Int)
(assert (>= |b#0| 0))
(assert (< |b#0| 256))
(assert (< |b#0| 256))
(assert (|std.json.hex_digit| |b#0|))
(assert (= (<= |b#0| 57) false))
(assert (= (<= |b#0| 70) true))
(assert (not (< (+ (- |b#0| 65) 10) 16)))
(check-sat)
(get-value (|b#0|))
