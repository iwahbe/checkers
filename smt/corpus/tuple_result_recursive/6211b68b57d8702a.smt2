(define-funs-rec ((|#tuple_result_recursive.walk| ((p0 Int) (p1 Int)) (|Tuple2| Int Int))) ((ite (and (>= p0 0) (>= p1 0)) (ite (not (< p1 p0)) ((as |tuple2| (|Tuple2| Int Int)) 0 p1) (|#tuple_result_recursive.walk| p0 (+ p1 1))) (|#tuple_result_recursive.walk#outside| p0 p1))))
