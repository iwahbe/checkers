(assert (=> (and (>= |#n#0| 0) (>= (+ |#i#1| 1) 0) (<= (+ |#i#1| 1) |#n#0|)) (>= (|tuple2.1| (|#tuple_result_recursive.walk| |#n#0| (+ |#i#1| 1))) 0)))
(assert (=> (and (>= |#n#0| 0) (>= (+ |#i#1| 1) 0) (<= (+ |#i#1| 1) |#n#0|)) (<= (+ |#i#1| 1) (|tuple2.1| (|#tuple_result_recursive.walk| |#n#0| (+ |#i#1| 1))))))
(assert (=> (and (>= |#n#0| 0) (>= (+ |#i#1| 1) 0) (<= (+ |#i#1| 1) |#n#0|)) (<= (|tuple2.1| (|#tuple_result_recursive.walk| |#n#0| (+ |#i#1| 1))) |#n#0|)))
(assert (>= |#n#0| 0))
(assert (>= |#i#1| 0))
(assert (= (< |#i#1| |#n#0|) true))
(assert (not (< |#i#1| (|tuple2.1| (|#tuple_result_recursive.walk| |#n#0| (+ |#i#1| 1))))))
(check-sat)
(get-value (|#i#1| |#n#0|))
