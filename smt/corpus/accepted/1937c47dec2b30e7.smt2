(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |w#0| Int)
(declare-const |h#1| Int)
(assert (! (>= |w#0| 0) :named |given.0|))
(assert (! (>= |h#1| 0) :named |given.1|))
(assert (! (>= |w#0| 0) :named |fact.0|))
(assert (! (>= |h#1| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|w#0| |h#1|))
