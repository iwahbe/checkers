(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |limit#0| Int)
(declare-const |value#1| Int)
(assert (! (>= |limit#0| 0) :named |given.0|))
(assert (! (>= |value#1| 0) :named |given.1|))
(assert (! (>= |limit#0| 0) :named |fact.0|))
(assert (! (>= |value#1| 0) :named |fact.1|))
(assert (! (<= |value#1| |limit#0|) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|limit#0| |value#1|))
