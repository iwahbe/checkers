(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-fun |std.prelude.not| (Bool) Bool)
(declare-fun |std.char.is_digit| (Int) Bool)
(declare-const |post#3| (Seq Int))
(assert (! (>= (seq.nth |post#3| 0) 0) :named |given.0|))
(assert (! (< (seq.nth |post#3| 0) 256) :named |given.1|))
(assert (! (ite (not (= (seq.len |post#3|) 0)) (|std.prelude.not| (|std.char.is_digit| (seq.nth |post#3| 0))) true) :named |fact.0|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|post#3|))
