(assert (= (|std.decimal.scaled| (* (* |m#0| (|std.decimal.pow10| (- |k#2| 1))) 10) |e#1|) (|std.decimal.scaled| (* |m#0| (|std.decimal.pow10| (- |k#2| 1))) (+ |e#1| 1))))
