(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-sort |std.decimal.Decimal| 0)
(declare-fun |std.decimal.pow10#outside| (Int) Int)
(declare-fun |std.decimal.scaled| (Int Int) |std.decimal.Decimal|)
(define-funs-rec ((|std.decimal.pow10| ((p0 Int)) Int)) ((ite (>= p0 0) (ite (not (= p0 0)) (* 10 (|std.decimal.pow10| (- p0 1))) 1) (|std.decimal.pow10#outside| p0))))
(declare-const |m#0| Int)
(declare-const |k#2| Int)
(declare-const |e#1| Int)
(assert (>= |k#2| 0))
(assert (=> (>= |k#2| 0) (>= (|std.decimal.pow10| |k#2|) 0)))
(assert (=> (>= |k#2| 0) (>= (|std.decimal.pow10| |k#2|) 0)))
(assert (=> (>= |k#2| 0) (>= (|std.decimal.pow10| |k#2|) 1)))
(assert (>= |k#2| 0))
(assert (= (> |k#2| 0) false))
(assert (not (= (|std.decimal.scaled| (* |m#0| (|std.decimal.pow10| |k#2|)) |e#1|) (|std.decimal.scaled| |m#0| (+ |e#1| |k#2|)))))
(check-sat)
(get-value (|m#0| |k#2| |e#1|))
