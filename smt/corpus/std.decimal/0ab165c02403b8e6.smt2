(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |b#0| (Seq Int))
(assert (! (>= (seq.nth |b#0| 0) 0) :named |given.0|))
(assert (! (< (seq.nth |b#0| 0) 256) :named |given.1|))
(assert (! (> (seq.len |b#0|) 0) :named |fact.0|))
(assert (! (= (seq.nth |b#0| 0) 45) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|b#0|))
