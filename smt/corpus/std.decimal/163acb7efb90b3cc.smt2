(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-fun |std.math.pow#outside| (Int Int) Int)
(declare-fun |std.prelude.not| (Bool) Bool)
(declare-fun |std.char.is_digit| (Int) Bool)
(declare-fun |std.math.pow| (Int Int) Int)
(declare-const |r#1| Int)
(declare-const |f#2| Int)
(declare-const |post#4| (Seq Int))
(assert (! (>= |r#1| 0) :named |given.0|))
(assert (! (>= |f#2| 0) :named |given.1|))
(assert (! (>= (seq.nth |post#4| 0) 0) :named |given.2|))
(assert (! (< (seq.nth |post#4| 0) 256) :named |given.3|))
(assert (! (=> (>= |f#2| 0) (ite (not (>= 10 0)) true (>= (|std.math.pow| 10 |f#2|) 0))) :named |given.4|))
(assert (! (=> (>= |f#2| 0) (ite (not (> 10 0)) true (> (|std.math.pow| 10 |f#2|) 0))) :named |given.5|))
(assert (! (>= |r#1| 0) :named |fact.0|))
(assert (! (>= |f#2| 0) :named |fact.1|))
(assert (! (< 0 |f#2|) :named |fact.2|))
(assert (! (< |r#1| (|std.math.pow| 10 |f#2|)) :named |fact.3|))
(assert (! (ite (not (= (seq.len |post#4|) 0)) (|std.prelude.not| (|std.char.is_digit| (seq.nth |post#4| 0))) true) :named |fact.4|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|r#1| |f#2| |post#4|))
