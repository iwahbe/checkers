(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-fun |std.decimal.pow10#outside| (Int) Int)
(define-funs-rec ((|std.decimal.pow10| ((p0 Int)) Int)) ((ite (>= p0 0) (ite (not (= p0 0)) (* 10 (|std.decimal.pow10| (- p0 1))) 1) (|std.decimal.pow10#outside| p0))))
(declare-const |f#1| Int)
(declare-const |r#0| Int)
(assert (>= |f#1| 0))
(assert (>= |r#0| 0))
(assert (=> (>= |f#1| 0) (>= (|std.decimal.pow10| |f#1|) 0)))
(assert (=> (>= |f#1| 0) (>= (|std.decimal.pow10| |f#1|) 0)))
(assert (=> (>= |f#1| 0) (>= (|std.decimal.pow10| |f#1|) 1)))
(assert (>= |r#0| 0))
(assert (>= |f#1| 0))
(assert (< |r#0| (|std.decimal.pow10| |f#1|)))
(assert (= (= |f#1| 0) false))
(assert (not (< (- |f#1| 1) |f#1|)))
(check-sat)
(get-value (|f#1| |r#0|))
