(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |lines#0| Int)
(declare-const |words#1| Int)
(declare-const |bytes#2| Int)
(assert (! (>= |lines#0| 0) :named |given.0|))
(assert (! (>= |words#1| 0) :named |given.1|))
(assert (! (>= |bytes#2| 0) :named |given.2|))
(assert (! (>= |lines#0| 0) :named |fact.0|))
(assert (! (>= |words#1| 0) :named |fact.1|))
(assert (! (>= |bytes#2| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|lines#0| |words#1| |bytes#2|))
