(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |x#0| Int)
(assert (! (<= 0 |x#0|) :named |given.0|))
(assert (! (<= |x#0| 10) :named |given.1|))
(assert (! (<= 0 |x#0|) :named |fact.0|))
(assert (! (<= |x#0| 10) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|x#0|))
