(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |x#0| Int)
(declare-const |y#1| Int)
(declare-const |z#2| Int)
(assert (! (>= |x#0| 0) :named |given.0|))
(assert (! (>= |y#1| 0) :named |given.1|))
(assert (! (>= |z#2| 0) :named |given.2|))
(assert (! (>= |x#0| 0) :named |fact.0|))
(assert (! (>= |y#1| 0) :named |fact.1|))
(assert (! (>= |z#2| 0) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|x#0| |y#1| |z#2|))
