(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |i#2| Int)
(declare-const |b#1| (Seq Int))
(declare-const |a#0| (Seq Int))
(assert (>= |i#2| 0))
(assert (>= (seq.nth |a#0| |i#2|) 0))
(assert (< (seq.nth |a#0| |i#2|) 256))
(assert (>= (seq.nth |b#1| |i#2|) 0))
(assert (< (seq.nth |b#1| |i#2|) 256))
(assert (>= |i#2| 0))
(assert (= (>= |i#2| (seq.len |b#1|)) false))
(assert (= (>= |i#2| (seq.len |a#0|)) false))
(assert (= (not (= (seq.nth |a#0| |i#2|) (seq.nth |b#1| |i#2|))) true))
(assert (not (< |i#2| (seq.len |b#1|))))
(check-sat)
(get-value (|i#2| |b#1| |a#0|))
