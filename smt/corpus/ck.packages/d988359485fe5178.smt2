(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-fun |ck.manifest.valid_name| ((Seq Int)) Bool)
(declare-fun |std.prelude.valid_utf8| ((Seq Int)) Bool)
(declare-const |by#2| (Seq Int))
(assert (! (|ck.manifest.valid_name| |by#2|) :named |given.0|))
(assert (! (|std.prelude.valid_utf8| |by#2|) :named |given.1|))
(assert (! (|ck.manifest.valid_name| |by#2|) :named |fact.0|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|by#2|))
