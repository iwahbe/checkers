(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|std.prelude.Ord Int.le| ((p0 Int) (p1 Int)) Bool)) ((<= p0 p1)))
(declare-const |x#0| Int)
(declare-const |z#2| Int)
(declare-const |y#1| Int)
(assert (|std.prelude.Ord Int.le| |x#0| |y#1|))
(assert (|std.prelude.Ord Int.le| |y#1| |z#2|))
(assert (not (|std.prelude.Ord Int.le| |x#0| |z#2|)))
(check-sat)
(get-value (|x#0| |z#2| |y#1|))
