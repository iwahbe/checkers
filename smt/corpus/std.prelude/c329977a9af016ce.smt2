(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|#std.prelude.not| ((p0 Bool)) Bool) (|#std.prelude.Ord Bool.le| ((p0 Bool) (p1 Bool)) Bool)) ((ite (not p0) true false) (ite (not (|#std.prelude.not| p0)) p1 true)))
(declare-const |#x#0| Bool)
(declare-const |#y#1| Bool)
(assert (not (ite (not (|#std.prelude.Ord Bool.le| |#x#0| |#y#1|)) (|#std.prelude.Ord Bool.le| |#y#1| |#x#0|) true)))
(check-sat)
(get-value (|#x#0| |#y#1|))
