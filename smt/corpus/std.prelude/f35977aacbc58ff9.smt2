(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|std.prelude.Ord Int.le| ((p0 Int) (p1 Int)) Bool)) ((<= p0 p1)))
(declare-const |x#0| Int)
(declare-const |y#1| Int)
(assert (not (ite (not (|std.prelude.Ord Int.le| |x#0| |y#1|)) (|std.prelude.Ord Int.le| |y#1| |x#0|) true)))
(check-sat)
(get-value (|x#0| |y#1|))
