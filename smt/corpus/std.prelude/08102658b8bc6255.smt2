(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |n#0| Int)
(assert (! (<= (- 128) |n#0|) :named |fact.0|))
(assert (! (< |n#0| 128) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|n#0|))
