(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-fun |type_param_refined.need_nat| (Int) Bool)
(declare-const |n#0| Int)
(declare-const |ok#1| Bool)
(assert (! (>= |n#0| 0) :named |fact.0|))
(assert (! (= |ok#1| (|type_param_refined.need_nat| |n#0|)) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|n#0| |ok#1|))
