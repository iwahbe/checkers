(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |k#1| Int)
(declare-const |f#0| (Seq Int))
(assert (! (>= |k#1| 0) :named |given.0|))
(assert (! (>= (seq.nth |f#0| |k#1|) 0) :named |given.1|))
(assert (! (< (seq.nth |f#0| |k#1|) 256) :named |given.2|))
(assert (! (>= |k#1| 0) :named |fact.0|))
(assert (! (< |k#1| (seq.len |f#0|)) :named |fact.1|))
(assert (! (= (seq.nth |f#0| |k#1|) 34) :named |fact.2|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|k#1| |f#0|))
