(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |a#0| Int)
(declare-const |b#1| Int)
(declare-const |c#2| Int)
(declare-const |d#3| Int)
(assert (! (>= |a#0| 0) :named |given.0|))
(assert (! (< |a#0| 256) :named |given.1|))
(assert (! (>= |b#1| 0) :named |given.2|))
(assert (! (< |b#1| 256) :named |given.3|))
(assert (! (>= |c#2| 0) :named |given.4|))
(assert (! (< |c#2| 256) :named |given.5|))
(assert (! (>= |d#3| 0) :named |given.6|))
(assert (! (< |d#3| 256) :named |given.7|))
(assert (! (< |a#0| 256) :named |fact.0|))
(assert (! (< |b#1| 256) :named |fact.1|))
(assert (! (< |c#2| 256) :named |fact.2|))
(assert (! (< |d#3| 256) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|a#0| |b#1| |c#2| |d#3|))
