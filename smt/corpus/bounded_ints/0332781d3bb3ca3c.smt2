(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(declare-const |#a#0| Int)
(declare-const |#b#1| Int)
(assert (>= |#a#0| 0))
(assert (< |#a#0| 65536))
(assert (>= |#b#1| 0))
(assert (< |#b#1| 256))
(assert (< |#a#0| 65536))
(assert (< |#b#1| 256))
(assert (<= 256 |#a#0|))
(assert (not (>= |#a#0| |#b#1|)))
(check-sat)
(get-value (|#a#0| |#b#1|))
