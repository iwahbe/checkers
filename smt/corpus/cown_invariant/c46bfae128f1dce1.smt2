(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 200000)
(set-logic ALL)
(define-funs-rec ((|#cown_invariant.bump| ((p0 Int)) Int)) ((ite (not (< (+ p0 1) 10)) 0 (+ p0 1))))
(declare-const |#n#2| Int)
(assert (>= |#n#2| 0))
(assert (< |#n#2| 10))
(assert (=> (< |#n#2| 10) (>= (|#cown_invariant.bump| |#n#2|) 0)))
(assert (=> (< |#n#2| 10) (< (|#cown_invariant.bump| |#n#2|) 10)))
(assert (< |#n#2| 10))
(assert (not (< (|#cown_invariant.bump| |#n#2|) 10)))
(check-sat)
(get-value (|#n#2|))
