(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |b#0| (Seq Int))
(declare-const |strict#1| Bool)
(assert (>= (seq.nth |b#0| 0) 0))
(assert (< (seq.nth |b#0| 0) 256))
(assert (= |strict#1| true))
(assert (= (> (seq.len |b#0|) 1) true))
(assert (= (= (seq.nth |b#0| 0) 48) true))
(assert (not (< 1 (seq.len |b#0|))))
(check-sat)
(get-value (|b#0| |strict#1|))
