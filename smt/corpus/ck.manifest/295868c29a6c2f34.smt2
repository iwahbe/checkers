(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#pos#0| Int)
(assert (! (>= |#pos#0| 0) :named |given.0|))
(assert (! (>= |#pos#0| 0) :named |fact.0|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#pos#0|))
