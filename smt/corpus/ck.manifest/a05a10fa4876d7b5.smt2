(set-logic ALL)
(declare-fun |ck.manifest.name_from#outside| ((Seq Int) Int) Bool)
(declare-fun |std.prelude.valid_utf8| ((Seq Int)) Bool)
(declare-fun |std.prelude.not| (Bool) Bool)
(declare-fun |ck.manifest.name_byte| (Int Bool) Bool)
(declare-fun |ck.manifest.name_from| ((Seq Int) Int) Bool)
(declare-fun |ck.manifest.valid_name| ((Seq Int)) Bool)
(declare-const |name#0| (Seq Int))
(assert (! (|ck.manifest.valid_name| |name#0|) :named |given.0|))
