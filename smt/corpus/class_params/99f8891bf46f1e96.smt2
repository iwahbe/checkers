(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(define-funs-rec ((|class_params.Measure Bool Int.measure| ((p0 Bool) (p1 Int)) Int)) ((ite (not p0) 0 1)))
(declare-const |x#0| Bool)
(declare-const |y#1| Int)
(assert (not (>= (|class_params.Measure Bool Int.measure| |x#0| |y#1|) 0)))
(check-sat)
(get-value (|x#0| |y#1|))
