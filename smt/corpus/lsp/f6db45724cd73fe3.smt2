(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 20000)
(set-logic ALL)
(declare-const |#line#1| Int)
(declare-const |#col#2| Int)
(declare-const |#end_line#3| Int)
(declare-const |#end_col#4| Int)
(assert (! (>= |#line#1| 0) :named |given.0|))
(assert (! (>= |#col#2| 0) :named |given.1|))
(assert (! (>= |#end_line#3| 0) :named |given.2|))
(assert (! (>= |#end_col#4| 0) :named |given.3|))
(assert (! (>= |#line#1| 0) :named |fact.0|))
(assert (! (>= |#col#2| 0) :named |fact.1|))
(assert (! (>= |#end_line#3| 0) :named |fact.2|))
(assert (! (>= |#end_col#4| 0) :named |fact.3|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|#line#1| |#col#2| |#end_line#3| |#end_col#4|))
