(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-fun |lsp.word_bytes| ((Seq Int) Int) Bool)
(define-funs-rec ((|lsp.upper_first| ((p0 (Seq Int))) Bool)) ((ite (not (> (seq.len p0) 0)) false (ite (not (<= 65 (seq.nth p0 0))) false (<= (seq.nth p0 0) 90)))))
(declare-const |new#1| (Seq Int))
(declare-const |old#0| (Seq Int))
(assert (< (seq.nth |new#1| 0) 256))
(assert (>= (seq.nth |new#1| 0) 0))
(assert (= (> (seq.len |new#1|) 0) true))
(assert (= (= (|lsp.upper_first| |old#0|) (|lsp.upper_first| |new#1|)) true))
(assert (= (|lsp.word_bytes| |new#1| 0) true))
(assert (= (|lsp.upper_first| |new#1|) false))
(assert (= (= (seq.nth |new#1| 0) 95) false))
(assert (not (< 0 (seq.len |new#1|))))
(check-sat)
(get-value (|new#1| |old#0|))
