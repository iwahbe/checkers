(assert (and (>= (|lsp.Span.1| |s#1|) 0) (>= (|lsp.Span.2| |s#1|) 0) (>= (|lsp.Span.3| |s#1|) 0) (>= (|lsp.Span.4| |s#1|) 0)))
(assert (>= (|lsp.Span.2| |s#1|) 0))
(assert (>= (|lsp.Span.4| |s#1|) 0))
(assert (>= (|lsp.Span.1| |s#1|) 0))
(assert (= (ite (not (<= (|lsp.Span.2| |s#1|) (|lsp.Span.4| |s#1|))) false (<= (|lsp.Span.4| |s#1|) (seq.len (|ck.text.line_at| |text#0| (|lsp.Span.1| |s#1|))))) true))
