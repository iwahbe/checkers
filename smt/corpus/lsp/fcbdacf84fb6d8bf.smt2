(set-logic ALL)
(declare-datatypes ((|lsp.Span| 0)) (((|lsp.Span| (|lsp.Span.0| (Seq Int)) (|lsp.Span.1| Int) (|lsp.Span.2| Int) (|lsp.Span.3| Int) (|lsp.Span.4| Int)))))
