(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |pl#3| Int)
(declare-const |pc#4| Int)
(assert (! (>= |pl#3| 0) :named |given.0|))
(assert (! (>= |pc#4| 0) :named |given.1|))
(assert (! (>= |pl#3| 0) :named |fact.0|))
(assert (! (>= |pc#4| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|pl#3| |pc#4|))
