(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |n#0| (Seq Int))
(assert (< (seq.nth |n#0| 0) 256))
(assert (>= (seq.nth |n#0| 0) 0))
(assert (= (> (seq.len |n#0|) 0) true))
(assert (= (<= 65 (seq.nth |n#0| 0)) true))
(assert (not (< 0 (seq.len |n#0|))))
(check-sat)
(get-value (|n#0|))
