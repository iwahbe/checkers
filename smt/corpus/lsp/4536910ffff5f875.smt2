(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |line#1| Int)
(declare-const |ch#2| Int)
(assert (! (>= |line#1| 0) :named |given.0|))
(assert (! (>= |ch#2| 0) :named |given.1|))
(assert (! (>= |line#1| 0) :named |fact.0|))
(assert (! (>= |ch#2| 0) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|line#1| |ch#2|))
