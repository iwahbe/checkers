(set-option :produce-unsat-cores true)
(set-option :produce-models true)
(set-option :rlimit 20000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-const |n#1| Int)
(declare-const |k#0| Int)
(assert (! (>= |n#1| 0) :named |given.0|))
(assert (! (>= |k#0| 0) :named |given.1|))
(assert (! (>= |n#1| 0) :named |fact.0|))
(assert (! (< |n#1| |k#0|) :named |fact.1|))
(assert (not false))
(check-sat)
(get-unsat-core)
(get-value (|n#1| |k#0|))
