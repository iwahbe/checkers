(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 6000000)
(set-logic ALL)
(declare-const |#pos#1| Int)
(declare-const |#i#2| Int)
(declare-const |#src#0| (Seq Int))
(assert (>= |#pos#1| 0))
(assert (>= |#i#2| 0))
(assert (>= (seq.nth |#src#0| |#i#2|) 0))
(assert (< (seq.nth |#src#0| |#i#2|) 256))
(assert (= (= |#i#2| |#pos#1|) false))
(assert (= (= (seq.nth |#src#0| |#i#2|) 10) true))
(assert (not (< (- |#pos#1| (+ |#i#2| 1)) (- |#pos#1| |#i#2|))))
(check-sat)
(get-value (|#pos#1| |#i#2| |#src#0|))
