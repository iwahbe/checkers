(set-option :produce-models true)
(set-option :rlimit 200000)
(set-option :timeout 60000)
(set-logic ALL)
(declare-sort |std.decimal.Decimal| 0)
(declare-fun |std.decimal.render| (|std.decimal.Decimal|) (Seq Int))
(declare-const |n#0| |std.decimal.Decimal|)
(assert (>= (seq.nth (|std.decimal.render| |n#0|) 0) 0))
(assert (< (seq.nth (|std.decimal.render| |n#0|) 0) 256))
(assert (ite (not (> (seq.len (|std.decimal.render| |n#0|)) 0)) false (ite (not (= (seq.nth (|std.decimal.render| |n#0|) 0) 45)) (ite (not (>= (seq.nth (|std.decimal.render| |n#0|) 0) 48)) false (<= (seq.nth (|std.decimal.render| |n#0|) 0) 57)) true)))
(assert (not (< 0 (seq.len (|std.decimal.render| |n#0|)))))
(check-sat)
(get-value (|n#0|))
