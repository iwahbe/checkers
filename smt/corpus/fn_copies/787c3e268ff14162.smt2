(set-option :produce-models true)
(set-option :timeout 60000)
(set-option :reproducible-resource-limit 6000000)
(set-logic ALL)
(declare-const |k#2| Int)
(declare-const |n#1| Int)
(assert (>= |k#2| 0))
(assert (>= |n#1| 0))
(assert (< |k#2| |n#1|))
(assert (not (< |k#2| |n#1|)))
(check-sat)
(get-value (|k#2| |n#1|))
